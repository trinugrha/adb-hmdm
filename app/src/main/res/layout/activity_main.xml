<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== MAIN APP ===== -->
    <LinearLayout
        android:id="@+id/mainApp"
        android:visibility="gone"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Web ADB HMDM v2.5"
            app:subtitle="Headwind MDM Installer — Android"
            app:menu="@menu/top_menu" />

        <TextView
            android:id="@+id/sessionTimer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/pill"
            android:padding="6dp"
            android:text="20m 00s"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:padding="12dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Status perangkat -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:text="● Status Perangkat (lokal)"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/deviceInfo"
                            android:text="Memuat info perangkat…"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:text="Aplikasi ini berjalan LANGSUNG di HP target (tidak perlu kabel USB / PC). Pilih APK lalu pasang, kemudian jadikan Headwind MDM sebagai Device Owner."
                            android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <Button
                                android:id="@+id/btnWireless"
                                android:text="ADB Wireless / IP"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                            <Space android:layout_width="8dp" android:layout_height="wrap_content" />
                            <Button
                                android:id="@+id/btnCopyOwnerCmd"
                                android:text="Salin perintah dpm"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Langkah 1: install APK -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:text="1 — Instalasi APK (bisa banyak)"
                            android:textStyle="bold"
                            android:textColor="@color/brand_600"
                            android:textSize="13sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:text="Pilih satu / beberapa file APK dari penyimpanan HP, lalu pasang sekaligus."
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/fileNameDisplay"
                            android:text="Belum ada APK dipilih"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <ProgressBar
                            android:id="@+id/progressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:visibility="gone"
                            android:max="100"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/progressText"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <Button
                                android:id="@+id/btnPickApk"
                                android:text="Pilih APK"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                            <Space android:layout_width="8dp" android:layout_height="wrap_content" />
                            <Button
                                android:id="@+id/btnInstall"
                                android:text="Pasang semua"
                                android:enabled="false"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Langkah 2: device owner -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:text="2 — Device Owner"
                            android:textStyle="bold"
                            android:textColor="@color/brand_600"
                            android:textSize="13sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/ownerBadge"
                            android:text="Status: belum diperiksa"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:text="Syarat: hapus semua akun Google / email &amp; akun lain di HP. Component: com.hmdm.launcher/.AdminReceiver"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <Button
                                android:id="@+id/btnCheckOwner"
                                android:text="Cek status"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                            <Space android:layout_width="8dp" android:layout_height="wrap_content" />
                            <Button
                                android:id="@+id/btnSetOwner"
                                android:text="Set Device Owner"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <Button
                            android:id="@+id/btnAutoAll"
                            android:text="⚡ Otomatis: Install + Set Owner"
                            android:enabled="false"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Kaspersky -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:text="Uninstall Kaspersky (com.kaspersky.kes)"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:text="1) Hapus data → 2) Matikan Admin perangkat di Pengaturan &gt; Keamanan → 3) Uninstal. Jika butuh hak sistem, gunakan perintah ADB dari PC (tombol salin di atas)."
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <Button
                                android:id="@+id/btnClearKaspersky"
                                android:text="Hapus data"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                            <Space android:layout_width="8dp" android:layout_height="wrap_content" />
                            <Button
                                android:id="@+id/btnUninstallKaspersky"
                                android:text="Uninstal"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Log -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:text="Terminal Log"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content" />
                            <Button
                                android:id="@+id/btnClearLog"
                                android:text="Bersihkan"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <ScrollView
                            android:id="@+id/logScroll"
                            android:background="@color/log_bg"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:padding="8dp">
                            <TextView
                                android:id="@+id/logOutput"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:textColor="@color/log_info"
                                android:textIsSelectable="true"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </ScrollView>
                        <TextView
                            android:text="© 2026 PT. Sumber Alfaria Trijaya, Tbk. — IT RZ01 · v2.5-android"
                            android:textSize="11sp"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ===== LOGIN OVERLAY ===== -->
    <LinearLayout
        android:id="@+id/loginModal"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#CC0F172A"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="🔒 Otentikasi Pengguna"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:text="Masukkan PIN 4 digit untuk membuka HMDM Installer v2.5"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/loginError"
                    android:visibility="gone"
                    android:text="PIN salah!"
                    android:textColor="#E11D48"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText android:id="@+id/pin1" android:inputType="numberPassword" android:maxLength="1"
                        android:textSize="22sp" android:gravity="center" android:fontFamily="monospace"
                        android:ems="1" android:layout_margin="4dp" android:layout_width="56dp" android:layout_height="56dp"
                        android:background="@drawable/pin_box" android:importantForAutofill="no" />
                    <EditText android:id="@+id/pin2" android:inputType="numberPassword" android:maxLength="1"
                        android:textSize="22sp" android:gravity="center" android:fontFamily="monospace"
                        android:ems="1" android:layout_margin="4dp" android:layout_width="56dp" android:layout_height="56dp"
                        android:background="@drawable/pin_box" android:importantForAutofill="no" />
                    <EditText android:id="@+id/pin3" android:inputType="numberPassword" android:maxLength="1"
                        android:textSize="22sp" android:gravity="center" android:fontFamily="monospace"
                        android:ems="1" android:layout_margin="4dp" android:layout_width="56dp" android:layout_height="56dp"
                        android:background="@drawable/pin_box" android:importantForAutofill="no" />
                    <EditText android:id="@+id/pin4" android:inputType="numberPassword" android:maxLength="1"
                        android:textSize="22sp" android:gravity="center" android:fontFamily="monospace"
                        android:ems="1" android:layout_margin="4dp" android:layout_width="56dp" android:layout_height="56dp"
                        android:background="@drawable/pin_box" android:importantForAutofill="no" />
                </LinearLayout>
                <Button
                    android:id="@+id/btnLogin"
                    android:text="Masuk"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:text="PIN default: 4567 (sama seperti versi Web). Ganti hash di AuthManager.kt untuk produksi."
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>
