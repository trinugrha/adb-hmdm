<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerX="0.7"
                android:centerY="0.2"
                android:centerColor="@color/header_mid"
                android:endColor="@color/header_end"
                android:startColor="@color/side"
                android:type="linear" />
        </shape>
    </item>
    <!-- lingkaran dekoratif kanan atas -->
    <item android:left="280dp" android:top="-90dp" android:right="-90dp" android:bottom="120dp">
        <shape android:shape="oval">
            <solid android:color="#22FFFFFF" />
        </shape>
    </item>
    <item android:left="230dp" android:top="-40dp" android:right="-50dp" android:bottom="60dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
    <!-- lengkung bawah -->
    <item android:top="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <corners android:topLeftRadius="0dp" android:topRightRadius="0dp"
                android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" />
        </shape>
    </item>
</layer-list>
