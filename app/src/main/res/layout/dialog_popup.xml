<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/popup_padding_h"
    android:paddingTop="@dimen/popup_padding_top"
    android:paddingEnd="@dimen/popup_padding_h"
    android:paddingBottom="@dimen/space_xl">

    <FrameLayout
        android:id="@+id/popupIconBg"
        android:layout_width="@dimen/popup_icon_bg"
        android:layout_height="@dimen/popup_icon_bg">

        <ImageView
            android:id="@+id/popupIcon"
            android:layout_width="@dimen/popup_icon"
            android:layout_height="@dimen/popup_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/popupTitle"
        style="@style/Hmdm.PopupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg" />

    <FrameLayout
        android:id="@+id/popupBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/popupScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/popupMessage"
                    style="@style/Hmdm.PopupMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <FrameLayout
                    android:id="@+id/popupContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/popupCancel"
            style="@style/Widget.Hmdm.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/control_height"
            android:layout_marginEnd="@dimen/space_md"
            android:layout_weight="1"
            android:text="@string/action_cancel"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/popupOk"
            android:layout_width="0dp"
            android:layout_height="@dimen/control_height"
            android:layout_weight="1"
            android:text="@string/action_ok" />
    </LinearLayout>
</LinearLayout>
