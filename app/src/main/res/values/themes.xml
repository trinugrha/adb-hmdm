<resources>
    <!-- ===================== Tema ===================== -->
    <style name="Theme.Hmdm" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent_text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/danger</item>
        <item name="android:textColorHighlight">@color/accent_text_soft</item>
        <item name="android:textColorLink">@color/accent_text</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/header_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>

        <item name="materialButtonStyle">@style/Widget.Hmdm.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Hmdm.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.Hmdm.TextInput</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Hmdm.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Hmdm.Dialog</item>
    </style>

    <!-- ===================== Bentuk ===================== -->
    <style name="ShapeAppearance.Hmdm.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="ShapeAppearance.Hmdm.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_dialog</item>
    </style>

    <!-- ===================== Tombol ===================== -->
    <!-- Dasar = tombol utama (terisi navy). Dipakai otomatis oleh semua MaterialButton. -->
    <style name="Widget.Hmdm.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/btn_main</item>
        <item name="iconTint">@color/on_tab_button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Hmdm.Button</item>
        <item name="android:textColor">@color/on_tab_button</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
    </style>

    <style name="Widget.Hmdm.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="iconTint">@color/accent_text</item>
        <item name="strokeColor">@color/accent_text</item>
        <item name="rippleColor">@color/accent_text</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Hmdm.Button</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
    </style>

    <style name="Widget.Hmdm.Button.Success">
        <item name="backgroundTint">@color/btn_status</item>
    </style>

    <style name="Widget.Hmdm.Button.Danger">
        <item name="backgroundTint">@color/danger_fill</item>
        <item name="iconTint">@color/on_danger_fill</item>
        <item name="android:textColor">@color/on_danger_fill</item>
    </style>

    <style name="Widget.Hmdm.Button.Warning">
        <item name="backgroundTint">@color/yellow_fill</item>
        <item name="iconTint">@color/on_yellow_fill</item>
        <item name="android:textColor">@color/on_yellow_fill</item>
    </style>

    <style name="Widget.Hmdm.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="iconTint">@color/accent_text</item>
        <item name="rippleColor">@color/accent_text</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Hmdm.Button</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/icon_button_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ===================== Input ===================== -->
    <style name="Widget.Hmdm.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_sm</item>
        <item name="boxStrokeColor">@color/accent_text</item>
        <item name="hintTextColor">@color/accent_text</item>
        <item name="cursorColor">@color/accent_text</item>
    </style>

    <style name="Widget.Hmdm.TextInput.Large" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/accent_text</item>
        <item name="hintTextColor">@color/accent_text</item>
        <item name="cursorColor">@color/accent_text</item>
    </style>

    <!-- Isian IP / port / kode: monospace, satu baris -->
    <style name="Hmdm.EditText.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
    </style>

    <!-- ===================== Kartu & kotak ===================== -->
    <style name="Widget.Hmdm.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- Kotak abu-abu berbingkai di dalam kartu (status, langkah) -->
    <style name="Hmdm.StatusBox" parent="">
        <item name="android:background">@drawable/bg_status_box</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- Lencana pil kecil berisi titik status + teks -->
    <style name="Hmdm.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>

    <!-- Tombol ikon bulat kecil (refresh, tambah, pengaturan) -->
    <style name="Hmdm.IconButton" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:padding">@dimen/icon_button_padding</item>
        <item name="android:tint">@color/accent_text</item>
    </style>

    <!-- ===================== Teks ===================== -->
    <style name="Hmdm.CardTitle" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Hmdm.CardTitle.Small">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Hmdm.CardHint" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Hmdm.CardHint.Step">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Hmdm.SectionLabel" parent="">
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Label kecil di dalam kotak status -->
    <style name="Hmdm.SectionLabel.Muted">
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Hmdm.ChipText" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Hmdm.Badge" parent="">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Hmdm.Badge.Danger">
        <item name="android:background">@drawable/bg_badge_danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Hmdm.Badge.Amber">
        <item name="android:background">@drawable/bg_badge_amber</item>
        <item name="android:textColor">@color/amber_text</item>
    </style>

    <!-- ===================== Dialog / popup ===================== -->
    <style name="ThemeOverlay.Hmdm.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Hmdm.Dialog</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Hmdm.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Hmdm.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Hmdm.Button.DialogPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Hmdm.Button.DialogNegative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Hmdm.Button.DialogNegative</item>
    </style>

    <style name="Hmdm.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Hmdm.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- Popup hasil (dialog_popup.xml) -->
    <style name="Hmdm.PopupTitle" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Hmdm.PopupMessage" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.Hmdm.Button.DialogPositive">
        <item name="android:minHeight">@dimen/control_height_dialog</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="Widget.Hmdm.Button.DialogNegative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Teks tab menu (kecil) -->
    <style name="Hmdm.TabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
    </style>
</resources>
